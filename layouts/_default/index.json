{{- /*
  全站搜索索引。

  三种模式（params.search.mode）：
    - auto   （默认）按索引总体积自动选择 single / shard
    - single 强制单文件索引（简单，适合中小站点）
    - shard  强制分片索引（主索引只含元数据，正文按文章拆分到 search/<slug>.json）

  阈值（params.search.autoThreshold，默认 512000 字节 ≈ 500 KB）：
    正文总体积超过阈值时，auto 模式自动切换到分片。

  Hugo 版本兼容（能力探测，见下方 $supportsPublish）：
    - resources.Publish 自 **Hugo 0.166.0** 起提供，分片模式依赖它。
    - Hugo < 0.166.0 + mode = auto（默认）超过阈值 -> **自动回退为单文件索引**
      （全文搜索能力不变），保证默认配置在声明的最低版本 0.128.0 上也能构建。
    - Hugo < 0.166.0 + mode = shard（显式）-> 显式报错并给出替代方案，
      不静默降级（符合 "分片需要 0.166+" 的配置约定）。

  向后兼容：params.search.shard = true 等价于 mode = "shard"。

  体积控制：正文完整收录（不做 3000 字截断），仅压缩连续空白；
  可选 params.search.contentLimit 限制单篇上限（默认 0 = 不限制）。

日期字段约定（UI / 机器分离）
--------------------------------
    date         机器字段：固定 `YYYY-MM-DD`，供程序解析 / 排序，**不得用于 UI 展示**
    dateDisplay  UI 字段：由 Hugo 在**构建期**按当前站点语言生成（走 i18n common.dateFormat），
                 前端只负责原样输出，不允许在 JS 里猜语言或重复实现日期格式化

  缺失日期（front matter 无 date 且文件名无日期前缀）时两个字段都输出空串，
  前端据此省略日期片段 —— 而不是显示 "0001-01-01" 或 "January 1, year 1"。
*/ -}}
{{- $limit := int (site.Params.search.contentLimit | default 0) -}}
{{- $mode := site.Params.search.mode | default "" -}}
{{- if not $mode -}}
  {{- $mode = cond (site.Params.search.shard | default false) "shard" "auto" -}}
{{- end -}}
{{- $threshold := int (site.Params.search.autoThreshold | default 512000) -}}
{{- $contentSections := site.Params.content.sections | default (slice (site.Params.content.section | default "posts")) -}}

{{- /* 能力探测：resources.Publish 自 Hugo **0.166.0** 起提供。
       分片模式依赖它把 chunk 写入构建产物；低版本必须回退，
       否则默认 auto 在大体量站点上会直接构建失败（can't evaluate field Publish）。

       版本比较：用**语义化的数值比较**（major/minor/patch），不使用字符串包含
       这类易误判的方式。hugo.Version 形如 "0.166.0"（可能带 "-DEV" / "+extended"
       等后缀，先按 "-" 截断——"+extended" 的 "+" 在 "." 前缀字段里不影响取值）。
       判定：major>0（1.x 及以后一律支持）或 (major==0 且 minor>=166)。 */ -}}
{{- $hugoVersion := hugo.Version -}}
{{- $verParts := split (index (split $hugoVersion "-") 0) "." -}}
{{- $verMajor := int (index $verParts 0) -}}
{{- $verMinor := cond (gt (len $verParts) 1) (int (index $verParts 1)) 0 -}}
{{- $supportsPublish := or (gt $verMajor 0) (and (eq $verMajor 0) (ge $verMinor 166)) -}}

{{- /* 第一步：收集条目并统计正文总体积 */ -}}
{{- $items := slice -}}
{{- /* 注意：range 内对"数值型"外部变量赋值不会传播到循环外（实测），
       因此这里用 slice 累积正文，循环结束后再统一计算总字节数。 */ -}}
{{- $allContent := slice -}}
{{- range where site.RegularPages "Section" "in" $contentSections -}}
  {{- $summary := "" -}}
  {{- with .Description -}}
    {{- $summary = . -}}
  {{- else -}}
    {{- $summary = .Summary | plainify | truncate 120 -}}
  {{- end -}}
  {{- $content := .Plain | replaceRE `\s+` " " -}}
  {{- if $limit -}}
    {{- /* contentLimit 按**字符（rune）**语义截断 —— 与 slice-runes.html 一致。
           历史缺陷（BUG-R2-001 / BUG-P1-003 同根因）：此处原先用字节数 `len` 判断，
           再拿该字节数当 rune 结束索引调用 slicestr，遇到中文正文（rune 数 < limit < 字节数）
           即越界 panic 并终止整站构建。slice-runes 内部用 countrunes 判断，绝不越界。 */ -}}
    {{- $content = partial "util/slice-runes.html" (dict "text" $content "n" $limit) -}}
  {{- end -}}
  {{- $allContent = $allContent | append $content -}}
  {{- $items = $items | append (dict
      "title" .Title
      "url" .RelPermalink
      "date" (cond .Date.IsZero "" (.Date.Format "2006-01-02"))
      "dateDisplay" (cond .Date.IsZero "" (.Date.Format (i18n "common.dateFormat")))
      "summary" $summary
      "content" $content
      "file" (.File.BaseFileName | default (anchorize .Title))
      "tags" (.Params.tags | default slice)
      "categories" (.Params.categories | default slice)
      "series" (.Params.series | default slice)
  ) -}}
{{- end -}}

{{- /* 第二步：计算总体积并决定模式 */ -}}
{{- $totalBytes := len (delimit $allContent "") -}}
{{- $wantShard := false -}}
{{- if eq $mode "shard" -}}
  {{- $wantShard = true -}}
{{- else if eq $mode "auto" -}}
  {{- $wantShard = gt $totalBytes $threshold -}}
{{- end -}}

{{- /* 能力回退（关键：让**默认配置**在所有声明支持的版本上都能构建）：
       - auto（默认）：低版本超过阈值时**安全回退**为单文件索引。全文搜索能力不变
         —— 单文件同样收录完整正文，仅请求形态不同（一个大文件 vs 多个 chunk）。
       - 显式 shard：低版本确实不支持，按**明确的配置约定显式报错**并给出可理解的
         说明与替代方案，不静默降级（否则用户会误以为已启用分片）。 */ -}}
{{- $useShard := $wantShard -}}
{{- if and $wantShard (not $supportsPublish) -}}
  {{- $useShard = false -}}
  {{- if eq $mode "shard" -}}
    {{- errorf "Nebula: params.search.mode = \"shard\" 需要 Hugo >= 0.166.0（依赖 resources.Publish），当前为 %s。请升级 Hugo，或改设 params.search.mode = \"single\"（留空则用默认 auto，低版本会自动回退为单文件索引）。" $hugoVersion -}}
  {{- else -}}
    {{- warnf "Nebula: 正文总量 %d 字节 > autoThreshold %d，但当前 Hugo %s 不支持分片（需 >= 0.166.0），已自动回退为单文件索引（params.search.mode = \"auto\"）。全文搜索不受影响。" $totalBytes $threshold $hugoVersion -}}
  {{- end -}}
{{- end -}}

{{- /* 第三步：输出
   分片模式：按"体积分块"（chunk）而非按文章分片 ——
   把若干篇正文合并进 search/chunk-N.json。这样 HTTP 请求数与总体积成正比而非与文章数成正比，
   500 篇文章也只需约 20 个并发请求（按文章分片会产生 500 个请求，实测搜索延迟明显更差）。 */ -}}
{{- $chunkSize := int (site.Params.search.chunkSize | default 204800) -}}
{{- $chunks := slice -}}
{{- $bucket := dict -}}
{{- $bucketSize := 0 -}}
{{- if $useShard -}}
  {{- range $items -}}
    {{- $bucket = merge $bucket (dict .file .content) -}}
    {{- $bucketSize = add $bucketSize (len .content) -}}
    {{- if ge $bucketSize $chunkSize -}}
      {{- $chunks = $chunks | append $bucket -}}
      {{- $bucket = dict -}}
      {{- $bucketSize = 0 -}}
    {{- end -}}
  {{- end -}}
  {{- if gt (len $bucket) 0 -}}
    {{- $chunks = $chunks | append $bucket -}}
  {{- end -}}
{{- end -}}

{{- $chunkURLs := slice -}}
{{- if $useShard -}}
  {{- range $i, $c := $chunks -}}
    {{- $res := resources.FromString (printf "search/chunk-%d.json" $i) ($c | jsonify) -}}
    {{- $pub := $res | resources.Publish -}}
    {{- $chunkURLs = $chunkURLs | append $pub.RelPermalink -}}
  {{- end -}}
{{- end -}}

{{- $index := slice -}}
{{- range $items -}}
  {{- $content := .content -}}
  {{- if $useShard -}}{{- $content = "" -}}{{- end -}}
  {{- $index = $index | append (dict
      "title" .title
      "url" .url
      "date" .date
      "dateDisplay" .dateDisplay
      "summary" .summary
      "content" $content
      "key" .file
      "tags" .tags
      "categories" .categories
      "series" .series
  ) -}}
{{- end -}}

{{- if $useShard -}}
  {{- /* 分片模式：输出 { chunks: [...], items: [...] } 结构 */ -}}
  {{- dict "chunks" $chunkURLs "items" $index | jsonify -}}
{{- else -}}
  {{- $index | jsonify -}}
{{- end -}}
